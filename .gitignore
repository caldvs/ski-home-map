.DS_Store
.claude/
.venv/
.venv-tests/
__pycache__/
.pytest_cache/
*.pyc

# Local copy of the OpenSkiData GeoPackage; only data/*.json is committed
/openskidata.gpkg

# Raw upstream of the openskimap style for diffing; the cleaned
# styles/terrain.json is what we ship. Regenerate with build_style.py.
/styles/_openskimap_terrain_v2.json
env.local
/js/config.local.js
# Generated by the deploy workflow from the SHADEMAP_API_KEY secret —
# never commit.
/js/config.js

# Session-specific debug screenshots from in-browser smoke tests.
# Real test fixtures (fixtures.json) and the parity harness (parity.html)
# are tracked; screenshots are throwaway.
tests/*.png

# Pre-existing experimental scratch — alternate map skeletons and
# auto-generated debugging frames that aren't part of the live app.
/scripts/*.png
/alps.html
/lake-district.html
/leaflet-shademap.html
/shademap-3d.html
/dist/leaflet-shadow-simulator.umd.min.js
